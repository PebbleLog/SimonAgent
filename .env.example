# 模型服务（Anthropic Messages API 或兼容端点）
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=your_model_name

# 网络搜索；不使用 web_search 时可以暂不配置
TAVILY_API_KEY=your_tavily_api_key_here

# 上下文窗口
AGENT_MAX_TURNS=20
AGENT_CONTEXT_MAX_MESSAGES=40
AGENT_CONTEXT_MAX_TOKENS=12000
AGENT_TOOL_RESULT_MAX_CHARS=3000

# LLM 记忆压缩
AGENT_MEMORY_COMPACT_AFTER=18
AGENT_MEMORY_COMPACT_AFTER_TOKENS=8000
AGENT_RECENT_MESSAGES=10

# 单轮执行护栏
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=1000

# templates/ 下的人设文件名
AGENT_SOUL_FILE=SOUL.md
